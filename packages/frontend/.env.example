# NoxStream frontend — copy to .env.local and fill in what you have.
# Every value here is optional. The app boots, explains what is missing, and
# never substitutes a placeholder address or key for a real one.

# ---------------------------------------------------------------------------
# Wallets
# ---------------------------------------------------------------------------
# WalletConnect Cloud project id — https://cloud.walletconnect.com
# Optional. Without it the app still connects browser-extension wallets
# (MetaMask, Rabby, Frame, Safe...) and the entire demo works; only QR-code /
# mobile pairing is unavailable. We deliberately do not ship a default id.
VITE_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------
# RPC
# ---------------------------------------------------------------------------
# Dedicated Ethereum Sepolia endpoint (Alchemy/Infura/...). Optional, but the
# public fallback rate-limits `eth_getLogs`, which is what the stream history
# panel uses.
VITE_SEPOLIA_RPC_URL=

# Block number the contracts were deployed at. Optional; narrows log queries so
# public RPCs stop rejecting them.
VITE_DEPLOY_BLOCK=

# ---------------------------------------------------------------------------
# Contract addresses — OPTIONAL OVERRIDES
# ---------------------------------------------------------------------------
# Normally the frontend reads the deploy script's output automatically from
# `packages/shared/src/deployments/*.json` (or `packages/shared/deployments/`,
# or `packages/frontend/deployments/`), matching the `DeploymentRecord` type in
# packages/shared/src/types.ts.
#
# Set these only to point the UI at a deployment whose record is not committed
# yet. All five must be set together — a partial override is ignored and
# reported, so you never end up half-wired to the wrong contracts.
VITE_PAYROLL_REGISTRY_ADDRESS=
VITE_STREAM_PAYROLL_ADDRESS=
VITE_CONFIDENTIAL_TOKEN_ADDRESS=
VITE_STREAM_ADAPTER_ADDRESS=
VITE_PAYOUT_ASSET_ADDRESS=
