# `@sablier/evm-utils` ships a postinstall script
#   cd node_modules/forge-std && ln -sf src/* .
# that fails on a clean `npm install` and aborts the entire install, so
# `@sablier/lockup` cannot be installed without this flag. We only consume
# Sablier's Solidity sources, which need no postinstall step.
#
# Keeping it here rather than in the README means `npm install` works from a
# clean clone with no special flags, which is what a reviewer will actually run.
ignore-scripts=true
